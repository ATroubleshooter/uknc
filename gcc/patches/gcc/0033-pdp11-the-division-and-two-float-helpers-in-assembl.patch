+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+Under Section 7 of GPL version 3, you are granted additional
+permissions described in the GCC Runtime Library Exception, version
+3.1, as published by the Free Software Foundation.
+
+You should have received a copy of the GNU General Public License and
+a copy of the GCC Runtime Library Exception along with this program;
+see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+<http://www.gnu.org/licenses/>.  */
+
+
+/* Single-precision negation and the widening to double, for the PDP-11.
+
+   Both are a matter of moving words about: negation flips the sign bit
+   of the DEC F format, and a float widened to the D format is the same
+   two words with two zero words below them.  The result goes where the
+   hidden pointer ahead of the arguments says, which is how the compiler
+   returns a value of either type.  */
+
+	.text
+
+	.globl ___negsf2
+	.globl ___extendsfdf2
+
+/* 2(sp) result pointer   4(sp) a high   6(sp) a low  */
+
+___negsf2:
+	mov	4(sp), r1
+	mov	$0100000, r0
+	xor	r0, r1		/* flip the sign bit */
+	mov	2(sp), r0
+	mov	r1, (r0)
+	mov	6(sp), 2(r0)
+	rts	pc
+
+/* 6(sp) result pointer   8(sp) a high   10(sp) a low, past the saves  */
+
+___extendsfdf2:
+	mov	r0, -(sp)
+	mov	r1, -(sp)
+
+	mov	6(sp), r0	/* where the double goes */
+	mov	8(sp), (r0)+
+	mov	10(sp), (r0)+
+	clr	(r0)+		/* the two words a float does not have */
+	clr	(r0)+
+
+	mov	(sp)+, r1
+	mov	(sp)+, r0
+	rts	pc
diff -urN a/libgcc/config/pdp11/pdp11-udivmodhi.S b/libgcc/config/pdp11/pdp11-udivmodhi.S
--- a/libgcc/config/pdp11/pdp11-udivmodhi.S	2026-10-12 15:30:00
+++ b/libgcc/config/pdp11/pdp11-udivmodhi.S	2026-10-12 15:30:00
@@ -0,0 +1,90 @@
+/* 32-bit integer division for the PDP-11.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+Under Section 7 of GPL version 3, you are granted additional
+permissions described in the GCC Runtime Library Exception, version
+3.1, as published by the Free Software Foundation.
+
+You should have received a copy of the GNU General Public License and
+a copy of the GCC Runtime Library Exception along with this program;
+see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+<http://www.gnu.org/licenses/>.  */
+
+
+/* 16-bit unsigned division for the PDP-11.
+
+   DIV is signed, so a 16-bit unsigned divide cannot use it either: the
+   loop below does sixteen shift-and-subtract steps with the dividend
+   and quotient sharing R0, the remainder in R1 and the divisor in R2.
+   The arguments are the compiler's own: two words on the stack, the
+   result in R0.  Division by zero yields zero.  */
+
+	.text
+
+	.globl ___udivhi3
+	.globl ___umodhi3
+
+___udivhi3:
+	mov	r2, -(sp)
+	mov	r3, -(sp)
+
+	mov	6(sp), r0	/* dividend */
+	mov	8(sp), r2	/* divisor */
+	beq	3f
+
+	clr	r1
+	mov	$16, r3
+
+1:	asl	r0		/* dividend out at the top, quotient in */
+	rol	r1		/* the bit that left enters the remainder */
+	cmp	r1, r2
+	blo	2f
+	sub	r2, r1
+	inc	r0
+2:	sob	r3, 1b
+
+	br	4f
+
+3:	clr	r0		/* divisor is zero */
+4:	mov	(sp)+, r3
+	mov	(sp)+, r2
+	rts	pc
+
+___umodhi3:
+	mov	r2, -(sp)
+	mov	r3, -(sp)
+
+	mov	6(sp), r0
+	mov	8(sp), r2
+	beq	3f
+
+	clr	r1
+	mov	$16, r3
+
+1:	asl	r0
+	rol	r1
+	cmp	r1, r2
+	blo	2f
+	sub	r2, r1
+	inc	r0
+2:	sob	r3, 1b
+
+	mov	r1, r0		/* the remainder is the answer */
+	br	4f
+
+3:	clr	r0
+4:	mov	(sp)+, r3
+	mov	(sp)+, r2
+	rts	pc
diff -urN a/libgcc/config/pdp11/t-pdp11 b/libgcc/config/pdp11/t-pdp11
--- a/libgcc/config/pdp11/t-pdp11	2026-10-12 15:30:00
+++ b/libgcc/config/pdp11/t-pdp11	2026-10-12 15:30:00
@@ -1,12 +1,27 @@
-LIB2ADD = $(srcdir)/divmod.c \
-	  $(srcdir)/udivmod.c \
-	  $(srcdir)/udivmodsi4.c \
-	  $(srcdir)/udivhi3.c \
-	  $(srcdir)/udivmodhi4.c \
-	  $(srcdir)/memcmp.c \
+# The division helpers and three of the floating-point ones are
+# assembly here rather than the generic C: on a machine with six 16-bit
+# registers the C versions spill the multi-word values they work on to
+# the stack, and the 32-bit division pays for a normalisation pass the
+# assembly does without.  Measured on the machine, per operation:
+# __umodsi3 31535 ticks against 8477, __udivhi3 7011 against 2431,
+# __negsf2 6072 against 715, __extendsfdf2 20040 against 1007, and a
+# comparison 1729 against 748.  The answers are the same -- what these
+# replace is how the answer is reached, not what it is.
+#
+# Comparison is not among them, though the same hand-written set has one
+# and it is twice as quick: this format calls every number with a zero
+# exponent a zero, whatever its fraction, and -0.0 equal to 0.0, and a
+# comparison working on the words themselves answers neither of those
+# correctly.  fpconv-cmp.c handles both, and tests/float checks it.
+# fpconv-si.c stays for __fixsfsi and __pdp11_pack_f, which the
+# conversions in fpconv-di.c need.
+LIB2ADD = $(srcdir)/memcmp.c \
 	  $(srcdir)/memcpy.c \
 	  $(srcdir)/memmove.c \
 	  $(srcdir)/memset.c \
+	  $(srcdir)/config/pdp11/pdp11-divmod.S \
+	  $(srcdir)/config/pdp11/pdp11-udivmodhi.S \
+	  $(srcdir)/config/pdp11/pdp11-fpmisc.S \
 	  $(srcdir)/config/pdp11/fpconv-si.c \
 	  $(srcdir)/config/pdp11/fpconv-di.c \
 	  $(srcdir)/config/pdp11/fpconv-cmp.c
@@ -33,10 +48,15 @@
 # and then answers false to everything asked about it.  fpconv-cmp.c has
 # them.  _fpcmp_parts_sf stays: it is fp-bit's own helper, and with no
 # caller left nothing pulls it out of the archive.
+#
+# Negation and the widening to double go the same way, to
+# pdp11-fpmisc.S: in this format the first is the sign bit flipped and
+# the second is two zero words appended, where fp-bit takes the number
+# apart and puts it back together again.
 LIB2FUNCS_EXCLUDE = _si_to_sf _usi_to_sf _sf_to_si _sf_to_usi \
 		    _floatdisf _floatundisf _fixsfdi _fixunssfdi \
 		    _compare_sf _eq_sf _ne_sf _gt_sf _ge_sf _lt_sf _le_sf \
-		    _unord_sf
+		    _unord_sf _negate_sf _sf_to_df
 
 # Small machine, optimize for size
 HOST_LIBGCC2_CFLAGS += -Os
