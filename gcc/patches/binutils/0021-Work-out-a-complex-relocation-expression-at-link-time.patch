+/* Deep enough for anything an assembler can write: the whole expression
+   has to fit in one data block, and each operand pushes one value.  */
+#define OBJ_CPLX_STACK	32
+
+/* The p-sect a complex expression names by number.  They are numbered
+   by their place in the GSD -- see struct obj_pdp11_walk.  */
+
+static asection *
+obj_pdp11_section_by_number (bfd *abfd, unsigned int number)
+{
+  asection *sec;
+
+  for (sec = abfd->sections; sec != NULL; sec = sec->next)
+    {
+      struct obj_pdp11_section_data *data = obj_section_data (sec);
+
+      if (data != NULL && data->number == number)
+	return sec;
+    }
+
+  return NULL;
+}
+
+/* Where SEC's byte at OFFSET has ended up in the output.  */
+
+static bfd_vma
+obj_pdp11_final_address (asection *sec, bfd_vma offset)
+{
+  if (sec->output_section == NULL)
+    return sec->vma + offset;
+
+  return sec->output_section->vma + sec->output_offset + offset;
+}
+
+/* Work out one complex expression and write the word it computes.
+
+   Table 2-7 of the RT-11 Volume and File Formats Manual: the string is
+   reverse Polish, the operands are 16-bit and two's complement, the
+   result is truncated from the left without a word said, a division by
+   zero yields zero with a warning, and a PC displacement -- the
+   difference between the two store operations -- applies to the result
+   only, never to an operand.  */
+
+static bool
+obj_pdp11_eval_complex (bfd *abfd, struct bfd_link_info *info,
+			asection *sec, const struct obj_pdp11_complex *cplx)
+{
+  struct obj_pdp11_section_data *data = obj_section_data (sec);
+  long stack[OBJ_CPLX_STACK];
+  unsigned int top = 0;
+  size_t k = 0;
+  long a, b;
+
+  /* Everything is kept sign-extended from 16 bits, so that the two
+     unary operations and the division mean what the assembler meant.  */
+#define SX(v)	((long) (short) (long) (v))
+#define PUSH(v)					\
+  do						\
+    {						\
+      if (top >= OBJ_CPLX_STACK)		\
+	goto malformed;				\
+      stack[top++] = SX (v);			\
+    }						\
+  while (0)
+#define POP(lv)					\
+  do						\
+    {						\
+      if (top == 0)				\
+	goto malformed;				\
+      (lv) = stack[--top];			\
+    }						\
+  while (0)
+
+  while (k < cplx->len)
+    {
+      unsigned int op = cplx->rpn[k++];
+
+      switch (op)
+	{
+	case OBJ_CPLX_NOP:
+	  break;
+
+	case OBJ_CPLX_ADD:
+	  POP (b); POP (a); PUSH (a + b);
+	  break;
+
+	case OBJ_CPLX_SUB:
+	  POP (b); POP (a); PUSH (a - b);
+	  break;
+
+	case OBJ_CPLX_MUL:
+	  POP (b); POP (a); PUSH (a * b);
+	  break;
+
+	case OBJ_CPLX_DIV:
+	  POP (b); POP (a);
+	  if (b == 0)
+	    {
+	      _bfd_error_handler
+		/* xgettext:c-format */
+		(_("%pB: %pA+%#lx: warning: division by zero in a complex "
+		   "relocation expression"),
+		 abfd, sec, (unsigned long) cplx->offset);
+	      PUSH (0);
+	    }
+	  else
+	    PUSH (a / b);
+	  break;
+
+	case OBJ_CPLX_AND:
+	  POP (b); POP (a); PUSH (a & b);
+	  break;
+
+	case OBJ_CPLX_OR:
+	  POP (b); POP (a); PUSH (a | b);
+	  break;
+
+	case OBJ_CPLX_XOR:
+	  POP (b); POP (a); PUSH (a ^ b);
+	  break;
+
+	case OBJ_CPLX_NEG:
+	  POP (a); PUSH (-a);
+	  break;
+
+	case OBJ_CPLX_COM:
+	  POP (a); PUSH (~a);
+	  break;
+
+	case OBJ_CPLX_GLOBAL:
+	  {
+	    struct bfd_link_hash_entry *h;
+	    char *name;
+
+	    if (k + 4 > cplx->len)
+	      goto malformed;
+	    name = obj_pdp11_name (abfd, cplx->rpn + k);
+	    if (name == NULL)
+	      return false;
+	    k += 4;
+
+	    h = bfd_link_hash_lookup (info->hash, name, false, false, true);
+	    if (h != NULL && h->type == bfd_link_hash_indirect)
+	      h = h->u.i.link;
+	    if (h == NULL
+		|| (h->type != bfd_link_hash_defined
+		    && h->type != bfd_link_hash_defweak))
+	      {
+		_bfd_error_handler
+		  /* xgettext:c-format */
+		  (_("%pB: %pA+%#lx: complex relocation expression needs "
+		     "`%s', which is not defined"),
+		   abfd, sec, (unsigned long) cplx->offset, name);
+		bfd_set_error (bfd_error_bad_value);
+		return false;
+	      }
+
+	    PUSH (h->u.def.value
+		  + obj_pdp11_final_address (h->u.def.section, 0));
+	  }
+	  break;
+
+	case OBJ_CPLX_PSECT:
+	  {
+	    asection *target;
+
+	    if (k + 3 > cplx->len)
+	      goto malformed;
+	    target = obj_pdp11_section_by_number (abfd, cplx->rpn[k]);
+	    if (target == NULL)
+	      {
+		_bfd_error_handler
+		  /* xgettext:c-format */
+		  (_("%pB: %pA+%#lx: complex relocation expression names "
+		     "p-sect %u, which this module does not declare"),
+		   abfd, sec, (unsigned long) cplx->offset,
+		   (unsigned) cplx->rpn[k]);
+		bfd_set_error (bfd_error_bad_value);
+		return false;
+	      }
+	    PUSH (obj_pdp11_final_address (target,
+					   bfd_getl16 (cplx->rpn + k + 1)));
+	    k += 3;
+	  }
+	  break;
+
+	case OBJ_CPLX_CONST:
+	  if (k + 2 > cplx->len)
+	    goto malformed;
+	  PUSH (bfd_getl16 (cplx->rpn + k));
+	  k += 2;
+	  break;
+
+	case OBJ_CPLX_STORE:
+	case OBJ_CPLX_STORE_DISP:
+	  POP (a);
+	  if (op == OBJ_CPLX_STORE_DISP)
+	    a -= (long) (obj_pdp11_final_address (sec, cplx->offset) + 2);
+	  if (data == NULL || data->contents == NULL
+	      || cplx->offset + 2 > sec->size)
+	    goto malformed;
+	  bfd_putl16 ((bfd_vma) (a & 0xffff), data->contents + cplx->offset);
+	  return true;
+
+	default:
+	  _bfd_error_handler
+	    /* xgettext:c-format */
+	    (_("%pB: %pA+%#lx: operation code 0%o in a complex relocation "
+	       "expression is not one of the fourteen there are"),
+	     abfd, sec, (unsigned long) cplx->offset, op);
+	  bfd_set_error (bfd_error_bad_value);
+	  return false;
+	}
+    }
+
+ malformed:
+  _bfd_error_handler
+    /* xgettext:c-format */
+    (_("%pB: %pA+%#lx: malformed complex relocation expression"),
+     abfd, sec, (unsigned long) cplx->offset);
+  bfd_set_error (bfd_error_bad_value);
+  return false;
+
+#undef POP
+#undef PUSH
+#undef SX
+}
+
+/* Work out every complex expression in ABFD; see obj-pdp11.h.  */
+
+bool
+bfd_obj_pdp11_resolve_complex (bfd *abfd, struct bfd_link_info *info)
+{
+  asection *sec;
+
+  if (abfd->xvec != &obj_pdp11_vec)
+    return true;
+
+  for (sec = abfd->sections; sec != NULL; sec = sec->next)
+    {
+      struct obj_pdp11_section_data *data = obj_section_data (sec);
+      unsigned int i;
+
+      if (data == NULL || data->cplxcount == 0 || data->resolved)
+	continue;
+
+      /* Relocatable output would have to carry the expression over
+	 rather than work it out, and an ELF relocation has nowhere to
+	 carry it.  */
+      if (bfd_link_relocatable (info))
+	{
+	  _bfd_error_handler
+	    /* xgettext:c-format */
+	    (_("%pB: %pA: complex relocation expressions cannot be carried "
+	       "into relocatable output"),
+	     abfd, sec);
+	  bfd_set_error (bfd_error_invalid_operation);
+	  return false;
+	}
+
+      for (i = 0; i < data->cplxcount; i++)
+	if (!obj_pdp11_eval_complex (abfd, info, sec, &data->complexes[i]))
+	  return false;
+
+      data->resolved = true;
+    }
+
+  return true;
+}
+
 static long
 obj_pdp11_canonicalize_reloc (bfd *abfd, asection *sec,
 			      arelent **relptr,
@@ -1071,9 +1423,13 @@
   struct obj_pdp11_section_data *data = obj_section_data (sec);
