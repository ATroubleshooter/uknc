+#ifndef OBJ_PDP11_H
+#define OBJ_PDP11_H
+
+/* Work out the complex relocation expressions (RLD entry type 017) ABFD
+   carries, if any, and write their words into the section contents the
+   linker is about to copy out.
+
+   No ELF relocation can stand for one of these -- they are arithmetic
+   over symbols, and a relocation is a symbol plus an addend -- so the
+   linker has to do it here instead, which it can only once every
+   address is final.  Call this from an emulation's finish hook, where
+   sections have their addresses and the link's hash table is still
+   alive; the sections' relocations cannot be read before it has run.
+
+   Returns false, with the reason reported, if an expression cannot be
+   worked out after all: it names an undefined symbol, divides by zero,
+   or the output is relocatable, where the expression would have to be
+   carried over rather than resolved and nothing in ELF can carry it.
+   Does nothing, successfully, to a bfd that is not an obj-pdp11 one.  */
+
+extern bool bfd_obj_pdp11_resolve_complex (bfd *abfd,
+					   struct bfd_link_info *info);
+
+#endif /* OBJ_PDP11_H */
