@@ -0,0 +1,72 @@
+# This shell script emits a C file. -*- C -*-
+#   Copyright (C) 2026 Free Software Foundation, Inc.
+#
+# This file is part of the GNU Binutils.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write to the Free Software
+# Foundation, Inc., 51 Franklin Street - Fifth Floor, Boston,
+# MA 02110-1301, USA.
+#
+# One hook, finish, for the three pdp11-rt11 emulations: an RT-11 object
+# module among the inputs can carry complex relocation expressions, and
+# this is where they get worked out.  Sourced by the emulations that
+# have an EXTRA_EM_FILE of their own (pdp11rt11sav, pdp11rt11rel) and
+# named as the EXTRA_EM_FILE of the one that does not (pdp11rt11), so
+# that all three behave the same way about them.
+
+fragment <<EOF
+
+/* --- \begin{pdp11rt11cplx.em} */
+#include "obj-pdp11.h"
+
+/* A complex relocation expression (RLD entry type 017 -- arithmetic
+   over symbols, which is what MACRO-11 writes for an expression that
+   goes beyond + and - over a relocatable or external symbol) has no
+   equivalent among ELF relocations: R_PDP11_16 is a symbol plus an
+   addend, with nowhere to put the arithmetic.  So the reader of the
+   format does not turn such an entry into a relocation at all; it keeps
+   the expression, and the work of evaluating it falls here.
+
+   Here, specifically, because this is the first moment when it can be
+   done and the last when it still can.  lang_process() calls
+   ldemul_finish() after lang_size_sections() and the final
+   lang_do_assignments(), so every section has its address and every
+   symbol its value; and it calls it before ldwrite(), so the words this
+   writes into the input sections' contents are still ahead of the copy
+   that puts them in the output.  (The other hook this emulation uses,
+   after_close_output, is far too late -- by then the output bfd is
+   closed and the link's hash table is gone.)
+
+   The reader refuses to hand out a section's relocations until this has
+   run, so a tool that is not a link -- objcopy, say -- cannot quietly
+   produce a file in which the word was never computed.  */
+
+static void
+gld${EMULATION_NAME}_finish (void)
+{
+  bfd *ibfd;
+
+  for (ibfd = link_info.input_bfds; ibfd != NULL; ibfd = ibfd->link.next)
+    if (!bfd_obj_pdp11_resolve_complex (ibfd, &link_info))
+      fatal (_("%P: %pB: cannot work out a complex relocation "
+	       "expression: %E\n"), ibfd);
+
+  ldelf_finish ();
+}
+
+/* --- \end{pdp11rt11cplx.em} */
+
+EOF
+
+LDEMUL_FINISH=gld"$EMULATION_NAME"_finish
