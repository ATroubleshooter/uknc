+  /* Reading the file was fine; using these relocations is not.  An
+     entry that could not be read at all was reported by kind and by
+     place when the file was read (see obj_pdp11_unsupported); a complex
+     expression that nobody has worked out yet is reported here, since
+     the place that should have done it is the link
+     (bfd_obj_pdp11_resolve_complex), and whoever is asking is not
+     one.  */
   if (data != NULL && data->unsupported)
     {
       _bfd_error_handler
@@ -1084,6 +1440,17 @@
       return -1;
     }
 
+  if (data != NULL && data->cplxcount != 0 && !data->resolved)
+    {
+      _bfd_error_handler
+	/* xgettext:c-format */
+	(_("%pB: %pA carries %u complex relocation expression(s), which only "
+	   "a link can work out"),
+	 abfd, sec, data->cplxcount);
+      bfd_set_error (bfd_error_invalid_operation);
+      return -1;
+    }
+
   if (data == NULL || data->relocs == NULL)
     {
       *relptr = NULL;
