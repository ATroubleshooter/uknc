 static bool
@@ -138,7 +146,32 @@
   tdata->image = (bfd_byte *) bfd_zalloc (abfd, SAV_IMAGE_SIZE);
   if (tdata->image == NULL)
     return false;
+  tdata->stack = SAV_DEFAULT_STACK_ADDRESS;
   abfd->tdata.any = (void *) tdata;
+  return true;
+}
+
+/* Override the default initial SP; see sav-pdp11.h.  */
+
+bool
+bfd_sav_pdp11_set_stack_address (bfd *abfd, bfd_vma addr)
+{
+  struct sav_pdp11_data *tdata;
+
+  if (abfd->xvec != &sav_pdp11_vec || abfd->tdata.any == NULL)
+    {
+      bfd_set_error (bfd_error_invalid_operation);
+      return false;
+    }
+
+  if ((addr & 1) != 0 || addr > SAV_IMAGE_SIZE)
+    {
+      bfd_set_error (bfd_error_bad_value);
+      return false;
+    }
+
+  tdata = (struct sav_pdp11_data *) abfd->tdata.any;
+  tdata->stack = addr;
   return true;
 }
 
