+#ifndef SAV_PDP11_H
+#define SAV_PDP11_H
+
+/* Set the initial stack pointer written to word 021 (byte offset 042)
+   of the image's header block, overriding the RT-11 default.  ABFD must
+   be a sav-pdp11 object open for writing whose format has been set, so
+   that its tdata exists; ADDR must be even, since the PDP-11 traps on a
+   word push through an odd SP.  Returns false, with the BFD error set,
+   if either does not hold.
+
+   This is ld's side of --stack=; see emultempl/pdp11rt11sav.em.  */
+
+extern bool bfd_sav_pdp11_set_stack_address (bfd *abfd, bfd_vma addr);
+
+#endif /* SAV_PDP11_H */
diff -urN a/ld/emultempl/pdp11rt11sav.em b/ld/emultempl/pdp11rt11sav.em
--- a/ld/emultempl/pdp11rt11sav.em	2026-10-10 19:30:00
+++ b/ld/emultempl/pdp11rt11sav.em	2026-10-10 19:30:00
@@ -29,8 +29,90 @@
 
 /* --- \begin{pdp11rt11sav.em} */
 #include "libiberty.h"
+#include "sav-pdp11.h"
 #include <errno.h>
 
+/* --stack=, RT-11 LINK's /M option by another name: the initial stack
+   pointer that goes into word 021 (byte offset 042) of the SAV image's
+   header block, in place of the RT-11 default of 01000.  Like /M it
+   takes either the address itself or the name of a global symbol whose
+   address to use.  Unlike /M, whose argument is always octal, a numeric
+   argument follows the C conventions ld uses everywhere else, so the
+   RT-11 default would be written 01000 in octal, 0x200 in hex or 512 in
+   decimal.  NULL until the option is seen.  */
+static const char *rt11_stack = NULL;
+
+/* Resolve --stack='s argument against IBFD, the executable this
+   emulation has just linked and is about to repack as a SAV image.  A
+   symbol is looked up in that file rather than in the linker's own hash
+   table because by the time this runs the link is over and the output
+   bfd has been closed; the file on disk is what is left.  */
+
+static bfd_vma
+gld${EMULATION_NAME}_stack_address (bfd *ibfd)
+{
+  bfd_vma addr;
+  char *end;
+  char octal[16];
+  long storage, count, i;
+  asymbol **syms;
+  bool found;
+
+  addr = (bfd_vma) strtoul (rt11_stack, &end, 0);
+  found = end != rt11_stack && *end == '\0';
+
+  if (!found)
+    {
+      /* Not a number, so a symbol name.  */
+      storage = bfd_get_symtab_upper_bound (ibfd);
+      if (storage < 0)
+	fatal (_("%P: %s: cannot read the symbol table: %E\n"),
+	       bfd_get_filename (ibfd));
+      if (storage == 0)
+	fatal (_("%P: --stack=%s: the linked output has no symbol table "
+		 "to look the symbol up in (--strip-all?)\n"), rt11_stack);
+
+      syms = (asymbol **) xmalloc (storage);
+      count = bfd_canonicalize_symtab (ibfd, syms);
+      if (count < 0)
+	fatal (_("%P: %s: cannot read the symbol table: %E\n"),
+	       bfd_get_filename (ibfd));
+
+      for (i = 0; i < count; i++)
+	if (strcmp (bfd_asymbol_name (syms[i]), rt11_stack) == 0
+	    && !bfd_is_und_section (bfd_asymbol_section (syms[i])))
+	  {
+	    addr = bfd_asymbol_value (syms[i]);
+	    found = true;
+	    break;
+	  }
+
+      free (syms);
+
+      if (!found)
+	fatal (_("%P: --stack=%s: no such number, and no such defined "
+		 "symbol either\n"), rt11_stack);
+    }
+
+  /* Addresses in this format are written in octal, and ld's own
+     diagnostics cannot print octal, so spell the resolved address out
+     here -- it is the one thing the user cannot see for themselves when
+     the argument was a symbol name.  */
+  sprintf (octal, "0%lo", (unsigned long) addr);
+
+  /* The PDP-11 traps on a word push through an odd SP, so a stack that
+     starts on one is never what the caller meant -- LINK's /M rejects
+     an odd address too.  */
+  if ((addr & 1) != 0)
+    fatal (_("%P: --stack=%s: the stack address %s is odd\n"),
+	   rt11_stack, octal);
+  if (addr > 0xfffe)
+    fatal (_("%P: --stack=%s: the stack address %s is outside the 64K "
+	     "PDP-11 address space\n"), rt11_stack, octal);
+
+  return addr;
+}
+
 /* This emulation's OUTPUT_FORMAT is the ordinary object format, the same
    as plain pdp11rt11, and not "sav-pdp11" -- deliberately.  That backend
    has a real relocation-resolution path; the generic BFD final-link path
@@ -84,6 +166,12 @@
   bfd_set_arch_mach (obfd, bfd_get_arch (ibfd), bfd_get_mach (ibfd));
   bfd_set_start_address (obfd, bfd_get_start_address (ibfd));
 
+  if (rt11_stack != NULL
+      && !bfd_sav_pdp11_set_stack_address
+	    (obfd, gld${EMULATION_NAME}_stack_address (ibfd)))
+    fatal (_("%P: %s: cannot set the RT-11 SAV stack address: %E\n"),
+	   tmp_filename);
+
   /* Two passes: bfd_set_section_contents() below marks the output bfd's
      output_has_begun once the first byte is written, and every
      bfd_make_section_*() call refuses to run after that point.  So every
@@ -157,4 +245,21 @@
 
 EOF
 
+PARSE_AND_LIST_LONGOPTS=${PARSE_AND_LIST_LONGOPTS}'
+  { "stack", required_argument, NULL, OPTION_RT11_STACK },
+'
+
+PARSE_AND_LIST_OPTIONS=${PARSE_AND_LIST_OPTIONS}'
+  fprintf (file, _("\
+  --stack=<address|symbol>    Set the initial stack pointer of the RT-11\n\
+                                SAV image, the way RT-11 LINK /M does;\n\
+                                the default is 01000\n"));
+'
+
+PARSE_AND_LIST_ARGS_CASES=${PARSE_AND_LIST_ARGS_CASES}'
+    case OPTION_RT11_STACK:
+      rt11_stack = optarg;
+      break;
+'
+
 LDEMUL_AFTER_CLOSE_OUTPUT=gld"$EMULATION_NAME"_after_close_output
