From: Yury Klushin <digger@live.ru>
Date: Fri, 10 Oct 2026 00:00:00 +0300
Subject: [PATCH] Read an RT-11 library as an archive

A library LIBR made is a BFD archive, so ar lists its modules, objdump
reads any of them, and ld pulls one out by the name of something it
defines.

A library is its own header record, then a directory of every entry
point in it, then the modules, one after another with nothing at all
between them -- not even a pad byte, so a module ending on an odd
address is followed straight away and the generic
openr_next_archived_file, which pads to even, cannot be used.  The
header record does not carry the checksum every other record does, so
what says this is a library is its record type and a module following
it; where the modules start is found by looking for the first one
rather than by reading the header's own layout.

The directory is not read either.  Every module carries its own, which
says the same thing, so the index ld needs is built from those -- which
is where LIBR got the directory from in the first place.  On
SYSLIB.OBJ that comes to 287 entries, exactly the number of
definitions its 112 modules declare between them.

Checked both ways round.  On DEC's own library: ar lists all 112
modules by name, each reads as a module, and a program referring to
$NXVAL links against it with ld pulling $NXADR out and placing its
SYS$I section.  And on one of ours: two modules written through BFD,
made into a library by LIBR on the machine, read back with both
members and the right index -- and a C program linked with -lmine
resolves ADDTWO through it, takes in only the module that defines it,
and prints 42 on the machine.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 bfd/obj-pdp11.c | 372 +++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 370 insertions(+), 2 deletions(-)

diff -urN a/bfd/obj-pdp11.c b/bfd/obj-pdp11.c
--- a/bfd/obj-pdp11.c	2026-10-10 01:51:39
+++ b/bfd/obj-pdp11.c	2026-10-10 01:51:39
@@ -1489,6 +1489,363 @@
   return _bfd_generic_new_section_hook (abfd, sec);
 }
 
+
+/* ---- libraries ---- */
+
+/* A library is what LIBR makes: its own header record, then a
+   directory of every entry point in it, then the modules, one after
+   another with nothing at all between them -- not even a pad byte, so
+   a module ending on an odd address is followed straight away.
+
+   The directory is not read here.  Every module carries its own, which
+   says the same thing, and the index below is built from those; that is
+   also where LIBR got the directory from.  The header record does not
+   carry the checksum every other record does, so what says this is a
+   library is its record type and a module following it.  */
+
+/* A library has to fit in memory to be looked through; nothing RT-11
+   can make comes near this.  */
+#define OBJ_MAX_LIB_SIZE	(4 * 1024 * 1024)
+
+/* Walks the records of the module at the start of BUF: how far it
+   reaches past its ENDMOD, and what it calls itself.  False if there
+   is no module there at all.  */
+
+static bool
+obj_pdp11_member_extent (const bfd_byte *buf, size_t size, size_t *end,
+			 char name[7])
+{
+  size_t i = 0;
+  bool first = true;
+
+  name[0] = '\0';
+  while (i + OBJ_REC_MIN <= size)
+    {
+      size_t length, sum, k;
+      unsigned int type;
+
+      if (buf[i] != OBJ_REC_MARK1 || buf[i + 1] != OBJ_REC_MARK2)
+	{
+	  if (first)
+	    return false;
+	  i++;
+	  continue;
+	}
+
+      length = bfd_getl16 (buf + i + 2);
+      if (length < OBJ_REC_MIN || i + length >= size)
+	return false;
+      for (sum = 0, k = i; k < i + length; k++)
+	sum += buf[k];
+      if (((0u - sum) & 0xff) != buf[i + length])
+	return false;
+
+      type = bfd_getl16 (buf + i + 4);
+      if (first && type != OBJ_BLK_GSD)
+	return false;
+      first = false;
+
+      if (type == OBJ_BLK_GSD && name[0] == '\0')
+	{
+	  const bfd_byte *body = buf + i + OBJ_REC_HEADER;
+	  size_t n = length - OBJ_REC_HEADER;
+	  size_t k2;
+
+	  for (k2 = 0; k2 + OBJ_GSD_ENTRY_SIZE <= n; k2 += OBJ_GSD_ENTRY_SIZE)
+	    if (body[k2 + 5] == OBJ_GSD_MODNAME)
+	      {
+		size_t len;
+
+		obj_pdp11_unrad50 (bfd_getl16 (body + k2), name);
+		obj_pdp11_unrad50 (bfd_getl16 (body + k2 + 2), name + 3);
+		name[6] = '\0';
+		for (len = 6; len > 0 && name[len - 1] == ' '; len--)
+		  name[len - 1] = '\0';
+		break;
+	      }
+	}
+
+      i += length + 1;
+      if (type == OBJ_BLK_ENDMOD)
+	{
+	  *end = i;
+	  return true;
+	}
+    }
+
+  return false;
+}
+
+/* The member at the current position: how long it is and what it is
+   called.  A module has no header of its own, so the position is put
+   back where it was and the data starts right there.  */
+
+static void *
+obj_pdp11_read_ar_hdr (bfd *abfd)
+{
+  struct areltdata *ared;
+  bfd_byte *buf;
+  char name[7];
+  file_ptr here = bfd_tell (abfd);
+  size_t got, end = 0, namelen;
+
+  buf = (bfd_byte *) bfd_malloc (OBJ_MAX_SIZE);
+  if (buf == NULL)
+    return NULL;
+
+  got = bfd_read (buf, OBJ_MAX_SIZE, abfd);
+  if (got == (size_t) -1 || bfd_seek (abfd, here, SEEK_SET) != 0)
+    {
+      free (buf);
+      return NULL;
+    }
+  if (!obj_pdp11_member_extent (buf, got, &end, name))
+    {
+      free (buf);
+      bfd_set_error (bfd_error_no_more_archived_files);
+      return NULL;
+    }
+  free (buf);
+
+  if (name[0] == '\0')
+    strcpy (name, "MODULE");
+  namelen = strlen (name);
+
+  ared = (struct areltdata *) bfd_zmalloc (sizeof (*ared) + namelen + 1);
+  if (ared == NULL)
+    return NULL;
+  ared->filename = (char *) (ared + 1);
+  memcpy (ared->filename, name, namelen + 1);
+  ared->parsed_size = end;
+  return ared;
+}
+
+static bfd *
+obj_pdp11_openr_next_archived_file (bfd *archive, bfd *last)
+{
+  file_ptr next;
+
+  if (last == NULL)
+    next = bfd_ardata (archive)->first_file_filepos;
+  else
+    next = last->proxy_origin + arelt_size (last);
+
+  if ((ufile_ptr) next >= bfd_get_size (archive))
+    {
+      bfd_set_error (bfd_error_no_more_archived_files);
+      return NULL;
+    }
+  return _bfd_get_elt_at_filepos (archive, next, NULL);
+}
+
+static bfd *
+obj_pdp11_get_elt_at_index (bfd *abfd, symindex index)
+{
+  carsym *entry;
+
+  if (bfd_ardata (abfd) == NULL
+      || index >= (symindex) bfd_ardata (abfd)->symdef_count)
+    {
+      bfd_set_error (bfd_error_invalid_operation);
+      return NULL;
+    }
+  entry = bfd_ardata (abfd)->symdefs + index;
+  return _bfd_get_elt_at_filepos (abfd, entry->file_offset, NULL);
+}
+
+/* The index the linker pulls a module out by: every global a module
+   defines, against where that module starts.  */
+
+static bool
+obj_pdp11_slurp_armap (bfd *abfd)
+{
+  ufile_ptr size = bfd_get_size (abfd);
+  file_ptr at = bfd_ardata (abfd)->first_file_filepos;
+  carsym *map = NULL;
+  size_t count = 0, alloc = 0;
+  bfd_byte *buf;
+  bool ok = true;
+
+  buf = (bfd_byte *) bfd_malloc (OBJ_MAX_SIZE);
+  if (buf == NULL)
+    return false;
+
+  while (ok && (ufile_ptr) at < size)
+    {
+      size_t got, end = 0, i;
+      char modname[7];
+
+      if (bfd_seek (abfd, at, SEEK_SET) != 0)
+	break;
+      got = bfd_read (buf, OBJ_MAX_SIZE, abfd);
+      if (got == (size_t) -1
+	  || !obj_pdp11_member_extent (buf, got, &end, modname))
+	break;
+
+      /* The module's own directory, up to the end of it.  */
+      i = 0;
+      while (i + OBJ_REC_MIN <= got)
+	{
+	  size_t length = bfd_getl16 (buf + i + 2);
+	  unsigned int type;
+	  const bfd_byte *body;
+	  size_t n, k;
+
+	  if (buf[i] != OBJ_REC_MARK1 || buf[i + 1] != OBJ_REC_MARK2
+	      || length < OBJ_REC_MIN || i + length >= got)
+	    break;
+	  type = bfd_getl16 (buf + i + 4);
+	  if (type == OBJ_BLK_ENDGSD)
+	    break;
+
+	  body = buf + i + OBJ_REC_HEADER;
+	  n = length - OBJ_REC_HEADER;
+	  for (k = 0; type == OBJ_BLK_GSD && k + OBJ_GSD_ENTRY_SIZE <= n;
+	       k += OBJ_GSD_ENTRY_SIZE)
+	    {
+	      char *name;
+
+	      if (body[k + 5] != OBJ_GSD_GLOBAL
+		  || (body[k + 4] & OBJ_GFLAG_DEF) == 0)
+		continue;
+
+	      if (count == alloc)
+		{
+		  carsym *bigger;
+
+		  alloc = alloc * 2 + 64;
+		  bigger = (carsym *) bfd_realloc (map,
+						   alloc * sizeof (carsym));
+		  if (bigger == NULL)
+		    {
+		      ok = false;
+		      break;
+		    }
+		  map = bigger;
+		}
+
+	      name = obj_pdp11_name (abfd, body + k);
+	      if (name == NULL)
+		{
+		  ok = false;
+		  break;
+		}
+	      map[count].name = name;
+	      map[count].file_offset = at;
+	      count++;
+	    }
+
+	  i += length + 1;
+	}
+
+      at += end;
+    }
+
+  free (buf);
+
+  if (!ok)
+    {
+      free (map);
+      return false;
+    }
+
+  if (count != 0)
+    {
+      carsym *kept = (carsym *) bfd_alloc (abfd, count * sizeof (carsym));
+
+      if (kept == NULL)
+	{
+	  free (map);
+	  return false;
+	}
+      memcpy (kept, map, count * sizeof (carsym));
+      bfd_ardata (abfd)->symdefs = kept;
+    }
+  free (map);
+
+  bfd_ardata (abfd)->symdef_count = count;
+  abfd->has_armap = count != 0;
+  return true;
+}
+
+/* Does ABFD hold a library?  */
+
+static bfd_cleanup
+obj_pdp11_archive_p (bfd *abfd)
+{
+  bfd_byte head[OBJ_REC_HEADER];
+  bfd_byte *buf;
+  ufile_ptr size = bfd_get_size (abfd);
+  size_t got, i;
+  bool found = false;
+
+  if (size == 0 || size > OBJ_MAX_LIB_SIZE)
+    {
+      bfd_set_error (bfd_error_wrong_format);
+      return NULL;
+    }
+
+  if (bfd_seek (abfd, 0, SEEK_SET) != 0)
+    return NULL;
+  if (bfd_read (head, sizeof (head), abfd) != sizeof (head)
+      || head[0] != OBJ_REC_MARK1 || head[1] != OBJ_REC_MARK2
+      || bfd_getl16 (head + 4) != OBJ_BLK_LIBHDR)
+    {
+      bfd_set_error (bfd_error_wrong_format);
+      return NULL;
+    }
+
+  /* Where the modules begin.  The header says so in a layout this does
+     not read, so the first thing in the file that is a module is taken
+     to be the first module.  */
+  if (bfd_seek (abfd, 0, SEEK_SET) != 0)
+    return NULL;
+  buf = (bfd_byte *) bfd_malloc ((size_t) size);
+  if (buf == NULL)
+    return NULL;
+  got = bfd_read (buf, (size_t) size, abfd);
+  if (got == (size_t) -1)
+    {
+      free (buf);
+      return NULL;
+    }
+
+  for (i = sizeof (head); i + OBJ_REC_MIN <= got; i++)
+    {
+      size_t end;
+      char name[7];
+
+      if (buf[i] != OBJ_REC_MARK1 || buf[i + 1] != OBJ_REC_MARK2)
+	continue;
+      if (obj_pdp11_member_extent (buf + i, got - i, &end, name))
+	{
+	  found = true;
+	  break;
+	}
+    }
+  free (buf);
+
+  if (!found)
+    {
+      bfd_set_error (bfd_error_wrong_format);
+      return NULL;
+    }
+
+  bfd_ardata (abfd) = (struct artdata *) bfd_zalloc (abfd,
+						     sizeof (struct artdata));
+  if (bfd_ardata (abfd) == NULL)
+    return NULL;
+  bfd_ardata (abfd)->first_file_filepos = (file_ptr) i;
+
+  if (!obj_pdp11_slurp_armap (abfd))
+    {
+      bfd_set_error (bfd_error_wrong_format);
+      return NULL;
+    }
+
+  return _bfd_no_cleanup;
+}
+
 #define obj_pdp11_close_and_cleanup	  _bfd_generic_close_and_cleanup
 #define obj_pdp11_bfd_free_cached_info	  _bfd_generic_bfd_free_cached_info
 #define obj_pdp11_make_empty_symbol	  _bfd_generic_make_empty_symbol
@@ -1551,6 +1908,17 @@
 #define obj_pdp11_init_private_section_data \
   _bfd_generic_init_private_section_data
 
+/* Reading a library, not making one: LIBR is what makes those.  */
+#define obj_pdp11_slurp_extended_name_table \
+  _bfd_noarchive_slurp_extended_name_table
+#define obj_pdp11_construct_extended_name_table \
+  _bfd_noarchive_construct_extended_name_table
+#define obj_pdp11_truncate_arname	  _bfd_noarchive_truncate_arname
+#define obj_pdp11_write_armap		  _bfd_noarchive_write_armap
+#define obj_pdp11_write_ar_hdr		  _bfd_noarchive_write_ar_hdr
+#define obj_pdp11_generic_stat_arch_elt	  bfd_generic_stat_arch_elt
+#define obj_pdp11_update_armap_timestamp  _bfd_noarchive_update_armap_timestamp
+
 const bfd_target obj_pdp11_vec =
 {
   "obj-pdp11",			/* Name.  */
@@ -1575,7 +1943,7 @@
   {				/* bfd_check_format.  */
     _bfd_dummy_target,
     obj_pdp11_object_p,
-    _bfd_dummy_target,		/* No archives yet.  */
+    obj_pdp11_archive_p,
     _bfd_dummy_target,
   },
   {				/* bfd_set_format.  */
@@ -1594,7 +1962,7 @@
   BFD_JUMP_TABLE_GENERIC (obj_pdp11),
   BFD_JUMP_TABLE_COPY (obj_pdp11),
   BFD_JUMP_TABLE_CORE (obj_pdp11),
-  BFD_JUMP_TABLE_ARCHIVE (_bfd_noarchive),
+  BFD_JUMP_TABLE_ARCHIVE (obj_pdp11),
   BFD_JUMP_TABLE_SYMBOLS (obj_pdp11),
   BFD_JUMP_TABLE_RELOCS (obj_pdp11),
   BFD_JUMP_TABLE_WRITE (obj_pdp11),
