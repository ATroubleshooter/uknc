--- a/bfd/obj-pdp11.c	1970-01-01 03:00:00
+++ b/bfd/obj-pdp11.c	2026-10-09 23:53:12
@@ -0,0 +1,702 @@
+/* BFD back-end for RT-11 relocatable object modules (PDP-11).
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+   This file is part of BFD, the Binary File Descriptor library.
+
